# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ── Persistence (MongoDB) ────────────────────────────────────────────────────
# Base URI WITHOUT the db name (the db name is appended from CSGE_DB).
# CS_GE uses its OWN instance so it never collides with other projects' mongo
# (GEM_CO uses 27017, itsm uses 27018). Bring one up with:
#   docker run -d --name csge-mongodb --restart unless-stopped \
#     -p 127.0.0.1:27019:27017 -v csge-mongo-data:/data/db mongo:7.0
MONGO_HOST=mongodb://localhost:27019
CSGE_DB=csge

# ── Microsoft (CloudFuze multi-tenant app registration) ──────────────────────
# App registered in Entra ID with Graph + Dynamics user_impersonation delegated
# permissions and the Power Platform admin application registered.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Redirect URI must match the Entra app registration exactly.
# MUST match the redirect URI registered on the Entra app EXACTLY. These are the
# registered ones, and they are also the defaults in config.ts. The server also serves
# /api/auth/*/callback, so the app WORKS with either path — but the identity provider
# only accepts the registered one, so using the other fails at consent with a
# redirect_uri_mismatch and reads like "the clouds will not connect".
MS_REDIRECT_URI=http://localhost:8080/callback/microsoft

# ── Google OAuth (customer identifies their Gemini Enterprise account) ───────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/callback/google

# ── Google Service Account (Domain-Wide Delegation for Gemini operations) ────
# Path to the SA key file, OR set GOOGLE_SA_KEY_JSON to the raw JSON (preferred
# in production via Secret Manager). NEVER commit the key.
GOOGLE_SA_KEY_FILE=
GOOGLE_SA_KEY_JSON=

# Fallback Gemini project number if auto-discovery fails (optional).
# Force the destination Gemini project, skipping auto-discovery. Leave UNSET for
# normal multi-tenant use — discovery picks the signed-in admin's project. Set it when
# the admin can see SEVERAL projects with engines and you need a specific one:
# discovery returns whichever Cloud Resource Manager lists first, and the wizard has no
# picker, so the choice is otherwise invisible.
GEMINI_PROJECT=

GEMINI_PROJECT_FALLBACK=

# HARD allowlist of accounts the SA may impersonate via Domain-Wide Delegation
# (optional; comma-separated exact emails or domains, e.g. "acme.com,admin@acme.com").
# When set, any impersonation target outside the list is refused (fail closed).
# Leave empty for multi-tenant SaaS. Recommended for single-org enterprise deploys.
GOOGLE_DWD_ALLOWED_IMPERSONATORS=

# Optional — Map Users Directory dropdown only. Do NOT mix these into the main
# Gemini DWD cloud-platform authorization; they are minted as a separate token.
#   https://www.googleapis.com/auth/admin.directory.domain.readonly
#   https://www.googleapis.com/auth/admin.directory.user.readonly
#   https://www.googleapis.com/auth/admin.directory.group.readonly

# ── Optional: LLM-assisted instruction refinement ───────────────────────────
# If set, the mapper refines synthesized instructions with an LLM. Leave blank
# to use the deterministic synthesizer only (still high fidelity).
INSTRUCTION_LLM_PROVIDER=      # "gemini" | "anthropic" | "" (off)
INSTRUCTION_LLM_API_KEY=
INSTRUCTION_LLM_MODEL=

# ── Studio Migrate AI chat agent ────────────────────────────────────────────
# Uses the SAME keys as GEM_CO: AZURE_OPENAI_* (preferred), else OPENAI_API_KEY,
# else INSTRUCTION_LLM_*. No separate AGENT_LLM key required.
# Without any LLM, chat still runs rule-based chip actions (navigate, auto-map, dry run).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# OPENAI_API_KEY=
# Optional overrides only if you need a different model than AZURE_OPENAI_DEPLOYMENT:
# AGENT_LLM_PROVIDER=
# AGENT_LLM_API_KEY=
# AGENT_LLM_MODEL=

# ── Optional: Dataverse-snapshot BigQuery threshold ─────────────────────────
# Row count above which a Dataverse reference-table snapshot is exported via
# BigQuery instead of Discovery Engine's inline documents:import (capped at
# 100 rows/request). Below the threshold, inline stays the default.
BQ_SNAPSHOT_ROW_THRESHOLD=200
BQ_SNAPSHOT_DATASET_LOCATION=US

# ── Application sign-in ───────────────────────────────────────────────────────
# Seeded on a FRESH database only (when appUsers is empty). Outside production a
# built-in development default is used if these are unset; in production nothing
# is seeded without them and nobody can sign in. Never commit real values.
SEED_ADMIN_EMAIL=admin@cloudfuze.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin User
SEED_DEMO_EMAIL=demo@cloudfuze.com
SEED_DEMO_PASSWORD=
SEED_DEMO_NAME=Demo User

# Days to retain verbatim Copilot payloads in the `rawAgents` collection for
# blind-spot analysis. 0 (the default) disables capture entirely.
#
# These are UNREDACTED customer payloads. Turn this on deliberately, for a
# specific investigation, and leave it off otherwise. Rows carry `expiresAt`
# and MongoDB deletes them, so the window is enforced by the database rather
# than by a cleanup job. Max 30.
RAW_RETENTION_DAYS=0

# Comma-separated Microsoft SERVICE PLAN names a source user must hold for the Map Users
# grid. Empty = any enabled licence (the safe default — a guessed SKU hides real people and
# looks identical to those people not existing). Copilot Studio is CCIBOTSPROD.
MS_REQUIRED_SERVICE_PLANS=
