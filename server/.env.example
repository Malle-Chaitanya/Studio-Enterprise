# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ── Persistence (MongoDB) ────────────────────────────────────────────────────
# Base URI WITHOUT the db name (the db name is appended from CSGE_DB).
# CS_GE uses its OWN instance so it never collides with other projects' mongo
# (GEM_CO uses 27017, itsm uses 27018). Bring one up with:
#   docker run -d --name csge-mongodb --restart unless-stopped \
#     -p 127.0.0.1:27019:27017 -v csge-mongo-data:/data/db mongo:7.0
MONGO_HOST=mongodb://localhost:27019
CSGE_DB=csge

# ── Microsoft (CloudFuze multi-tenant app registration) ──────────────────────
# App registered in Entra ID with Graph + Dynamics user_impersonation delegated
# permissions and the Power Platform admin application registered.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Redirect URI must match the Entra app registration exactly.
MS_REDIRECT_URI=http://localhost:8080/api/auth/microsoft/callback

# ── Google OAuth (customer identifies their Gemini Enterprise account) ───────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ── Google Service Account (Domain-Wide Delegation for Gemini operations) ────
# Path to the SA key file, OR set GOOGLE_SA_KEY_JSON to the raw JSON (preferred
# in production via Secret Manager). NEVER commit the key.
GOOGLE_SA_KEY_FILE=
GOOGLE_SA_KEY_JSON=

# Fallback Gemini project number if auto-discovery fails (optional).
GEMINI_PROJECT_FALLBACK=

# HARD allowlist of accounts the SA may impersonate via Domain-Wide Delegation
# (optional; comma-separated exact emails or domains, e.g. "acme.com,admin@acme.com").
# When set, any impersonation target outside the list is refused (fail closed).
# Leave empty for multi-tenant SaaS. Recommended for single-org enterprise deploys.
GOOGLE_DWD_ALLOWED_IMPERSONATORS=

# ── Optional: LLM-assisted instruction refinement ───────────────────────────
# If set, the mapper refines synthesized instructions with an LLM. Leave blank
# to use the deterministic synthesizer only (still high fidelity).
INSTRUCTION_LLM_PROVIDER=      # "gemini" | "anthropic" | "" (off)
INSTRUCTION_LLM_API_KEY=
INSTRUCTION_LLM_MODEL=
