# Paste the current SprintBoard session bearer token (DevTools > Network > any
# /api/ request > Authorization header). This expires when your SprintBoard
# session does - there is no PAT option in SprintBoard, so when the poller
# starts logging 401s, re-login in the browser and paste the new value here.
SPRINTBOARD_TOKEN=

SPRINTBOARD_BASE_URL=https://sprintboard.cftools.live
SPRINTBOARD_SPACE_ID=326f3046-aa1b-445d-a768-19ef68e4483a
SPRINTBOARD_USER_ID=usr-13b081b7-0f76-4ef7-a1ae-e4c53c51304e

# Absolute path to the ISOLATED worktree this agent operates in - never point
# this at your own interactive checkout, the agent runs `git checkout -b`
# there and will yank the branch out from under you mid-edit.
REPO_PATH=C:/Users/LaxmanKadari/STD_ENT/Studio-Enterprise-agent

PR_BASE_BRANCH=main
POLL_INTERVAL_MS=300000

# Left unset (default) = the spawned Claude session runs with normal
# permission prompting, which will just hang with nobody there to approve.
# Set to "1" only once you've decided, deliberately, that you want an
# unattended session skipping permission checks - that decision is yours,
# not a default this tool sets for you.
CLAUDE_SKIP_PERMISSIONS=
